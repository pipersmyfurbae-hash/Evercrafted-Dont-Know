rules_version = '2';

// Security boundary for Part V of the migration plan in
// "Moodoor Matching Code Walkthrough and Platform Migration Plan.md".
//
// The Express/Admin SDK server (server.ts, services/firebase/moodoorProjection.ts)
// bypasses these rules entirely — they only govern direct client SDK access
// (lib/firebase.ts's `db`, used by contexts/AuthContext.tsx and the legacy
// services/moodoorMatching.ts client reads). That split is deliberate: the
// public Moodoor finder is meant to go through POST /api/v1/moodoor/matches,
// never a direct client read of moodoor_public_listings — these rules just
// make sure a client read of that collection can't leak more than the
// projection already contains, in case something ever falls back to it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/create/update their own profile document (created by
    // AuthContext.tsx on first sign-in); role/tier changes should go through
    // an admin-only server path, not an open client write — until that
    // exists, block clients from writing their own `role` or `tier` field.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && !('role' in request.resource.data)
        && !('tier' in request.resource.data);
      allow update: if (isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.tier == resource.data.tier) || isAdmin();
    }

    // Canonical marketplace listings: owner and admin only. The public
    // finder must never read this collection directly — it reads the
    // moodoor_public_listings projection instead (built server-side by
    // services/firebase/moodoorProjection.ts).
    match /marketplace_listings/{listingId} {
      allow read: if isOwner(resource.data.creatorId) || isAdmin();
      allow create: if isSignedIn() && isOwner(request.resource.data.creatorId);
      allow update, delete: if isOwner(resource.data.creatorId) || isAdmin();
    }

    // Public, read-only Moodoor projection. Only the server (Admin SDK,
    // which bypasses these rules) may write it — clients get read-only
    // access to already-public-safe fields.
    match /moodoor_public_listings/{listingId} {
      allow read: if true;
      allow write: if false;
    }

    // Immutable publication audit trail — server-only, never client-visible.
    match /moodoor_publication_events/{eventId} {
      allow read, write: if false;
    }

    // User-generated design projects (services/projectService.ts).
    match /projects/{projectId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // Deployment-only migration checkpoints — no client access at all.
    match /schema_migrations/{docId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
